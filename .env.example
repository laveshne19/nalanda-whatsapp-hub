# Copy to .env on the server. Never commit the real file.
# On the VPS these are set in the Hostinger Docker manager project environment.

# --- OpenWA ---------------------------------------------------------------
OPENWA_URL=http://openwa-api:2785
# A dedicated OPERATOR key made for the hub in the OpenWA dashboard (not your admin key).
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# The hub registers its own webhook in OpenWA at start. Leave unset to do it by hand.
HUB_WEBHOOK_URL=http://nalanda-hub:8080/webhook/openwa
# Random, 16+ characters. OpenWA signs every webhook with it.
WEBHOOK_SECRET=

# --- Shopify (order tracking and cancellation requests) ---------------------
# App made in the Shopify Dev Dashboard, with ONLY the read_orders permission, installed on the store.
# The hub swaps the client id and secret for a token that lasts 24 hours and renews it by itself.
SHOPIFY_SHOP_DOMAIN=ragqi1-q9.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Older custom apps with a fixed token can use this instead:
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-10

# --- Your team ---------------------------------------------------------------
# Bulk enquiries, cancellation requests and lead alerts go here. This chat can also
# message the bot "report", "leads" and "done REF".
STAFF_CHAT_ID=919569913332@c.us
# Shown to wholesale customers as the direct number.
WHOLESALE_CONTACT=+91 95699 13332
# Daily report time in India time (hour, 0 to 23).
REPORT_HOUR_IST=20
BUSINESS_HOURS=

# --- Website enquiries (corporategiftingindia.co) ------------------------------
# Secret shared with the website's server-side function. Without it the endpoint is off.
LEADS_SECRET=
# Start the WhatsApp chat with a new lead by itself (OpenWA's daily limits still apply).
# LEAD_PROACTIVE=true
# Tell the team the moment a lead arrives, not only when it is qualified.
# LEAD_NOTIFY_ON_CREATE=true
# LEAD_PROACTIVE_PER_DAY=30
# LEAD_INTAKE_PER_HOUR=60
# A lead that has not answered after this long is handed to a person to call.
# LEAD_STALE_MINUTES=30

# --- Behaviour ----------------------------------------------------------------
# REPLIES_PER_CHAT_PER_HOUR=10
# HANDOFF_HOURS=12
# Pause the bot when a person replies from the phone. Leave off until tested on the live number.
# STAFF_REPLY_PAUSES=false

PORT=8080
STATE_PATH=/app/data/state.json

# Copy to .env on the server. Never commit the real file.

# Where OpenWA lives (inside the same Docker network) and the key the hub uses to send.
# Create a dedicated OPERATOR key for the hub in the OpenWA dashboard, not your admin key.
OPENWA_URL=http://openwa-api:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Shared secret OpenWA signs every webhook with (16+ characters, random).
# Use the same value when you register the webhook in OpenWA.
WEBHOOK_SECRET=

# Shopify (optional, order tracking is switched off without these).
# Create a custom app in Shopify admin with ONLY the read_orders scope.
SHOPIFY_SHOP_DOMAIN=www.nalandaenterprises.com
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-10

# A staff WhatsApp number that gets a note for bulk enquiries and handoffs, like 919999999999@c.us
STAFF_CHAT_ID=
BUSINESS_HOURS=10am to 7pm, Monday to Saturday

# Behaviour
# REPLIES_PER_CHAT_PER_HOUR=10
# HANDOFF_HOURS=12
# Pause the bot when a person replies from the phone. Leave off until tested on the live number.
# STAFF_REPLY_PAUSES=false

PORT=8080
STATE_PATH=/app/data/state.json
